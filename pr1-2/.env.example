# Copy this file to ".env" and fill in your own values.
# The real .env file is git-ignored and must never be committed.

# --- AviationStack (required for data retrieval) ---------------------------
# Free account: https://aviationstack.com  (free tier: /v1/flights endpoint)
AVIATIONSTACK_API_KEY=

# Free plan is HTTP-only - keep http:// here. Paid plans may use https://.
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# --- Request behaviour ------------------------------------------------------
REQUEST_TIMEOUT=20
DEFAULT_RECORD_LIMIT=100

# --- Optional weather context (Open-Meteo, free, no key) -------------------
# Informational only - shown in the desktop status bar for a location you
# choose. Delays are attributed to weather ONLY if the flight API says so.
ENABLE_WEATHER_LOOKUP=1
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LABEL=Monitored location
